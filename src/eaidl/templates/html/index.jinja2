{% extends "base.jinja2" %}

{% block title %}{{ config.documentation.title }} - Home{% endblock %}

{% block content %}
<div class="container-fluid">
    <div class="row">
        <div class="col-lg-8">
            <h1 class="display-4 mb-4">{{ config.documentation.title }}</h1>

            <p class="lead">
                Interactive documentation for Enterprise Architect data models.
                Navigate through packages, explore class definitions, and view interactive diagrams.
            </p>

            <div class="row g-4 my-4">
                <div class="col-md-3">
                    <div class="card">
                        <div class="card-body text-center">
                            <h2 class="display-6 text-primary">{{ stats.packages }}</h2>
                            <p class="mb-0">Packages</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card">
                        <div class="card-body text-center">
                            <h2 class="display-6 text-info">{{ stats.structs }}</h2>
                            <p class="mb-0">Structs</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card">
                        <div class="card-body text-center">
                            <h2 class="display-6 text-success">{{ stats.enums }}</h2>
                            <p class="mb-0">Enums</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card">
                        <div class="card-body text-center">
                            <h2 class="display-6 text-warning">{{ stats.unions }}</h2>
                            <p class="mb-0">Unions</p>
                        </div>
                    </div>
                </div>
            </div>

            <h2 class="mt-5 mb-3">Getting Started</h2>
            {% if config.documentation.root_packages %}
            <div class="card mb-3"><div class="card-body">
                <h5 class="card-title"><a href="diagrams.html">Browse Model Views</a></h5>
                <p class="card-text">Explore all scoped model diagrams, grouped for developers, including behaviour and interactions.</p>
            </div></div>
            {% endif %}
            <div class="card mb-3">
                <div class="card-body">
                    <h5 class="card-title">Browse Packages</h5>
                    <p class="card-text">
                        Use the sidebar navigation to browse through the package hierarchy.
                        Each package contains classes, structs, enums, and other type definitions.
                    </p>
                </div>
            </div>

            <div class="card mb-3">
                <div class="card-body">
                    <h5 class="card-title">Search</h5>
                    <p class="card-text">
                        Click the "Search" button in the navigation bar to search across all classes,
                        attributes, and packages. Search supports fuzzy matching for easier discovery.
                    </p>
                </div>
            </div>

            <div class="card mb-3">
                <div class="card-body">
                    <h5 class="card-title">Interactive Diagrams</h5>
                    <p class="card-text">
                        Each package with classes has an interactive class diagram showing relationships
                        and structure. Click on diagram elements to navigate to detailed class pages.
                    </p>
                </div>
            </div>

            {% if config.documentation.root_packages %}
            <h2 class="mt-5 mb-3">Shared model views</h2>
            <div class="list-group">
            {% for key, section in config.documentation.sections.items() %}
            {% set grouped = namespace(value=false) %}
            {% for keys in config.documentation.package_group_sections.values() %}
            {% if key in keys %}{% set grouped.value=true %}{% endif %}
            {% endfor %}
            {% if not grouped.value %}<a class="list-group-item list-group-item-action" href="diagrams.html#{{ key }}">{{ section.title }}</a>{% endif %}
            {% endfor %}
            <a class="list-group-item list-group-item-action" href="diagrams.html#other">Other model views</a>
            </div>
            {% endif %}
            <h2 class="mt-5 mb-3">AEP references</h2>
            {% for title, names in config.documentation.package_groups.items() %}
            <h3>{{ title }}</h3>
            <div class="list-group mb-3">
            {% for package in packages %}
            {% if package.name in names %}
            {% if package.name in config.documentation.flatten_package_roots %}
            <a class="list-group-item list-group-item-action" href="packages/{{ package.name }}/index.html">Overview</a>
            {% for nested in package.packages %}
            <a class="list-group-item list-group-item-action" href="packages/{{ package.name }}/{{ nested.name }}/index.html">{{ nested.name }}</a>
            {% endfor %}
            {% else %}
            <a class="list-group-item list-group-item-action" href="packages/{{ package.name }}/index.html">{{ package.name }}</a>
            {% endif %}
            {% endif %}
            {% endfor %}
            </div>
            {% endfor %}
            {% for package in packages %}
            {% set grouped = namespace(value=false) %}
            {% for names in config.documentation.package_groups.values() %}
            {% if package.name in names %}{% set grouped.value=true %}{% endif %}
            {% endfor %}
            {% if package.name != 'ext' and not grouped.value %}
            <a class="list-group-item list-group-item-action" href="packages/{{ package.name }}/index.html">{{ package.name }}</a>
            {% endif %}
            {% endfor %}
        </div>
    </div>
</div>
{% endblock %}
